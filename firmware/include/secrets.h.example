#pragma once

// Copy this file to secrets.h and fill in your credentials.
// secrets.h is git-ignored and never committed.
#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// Pre-shared token — must match WS_TOKEN in docker/.env.
// Use any long random string, e.g.: openssl rand -hex 32
#define WS_TOKEN        "change-me"
